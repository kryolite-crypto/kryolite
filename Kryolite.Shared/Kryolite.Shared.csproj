<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Optimize>true</Optimize>
	<RootNamespace>Kryolite.Shared</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Crypto.RIPEMD" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Geralt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kryolite.Constant\Kryolite.Constant.csproj" />
    <ProjectReference Include="..\Kryolite.Type\Kryolite.Type.csproj" />
    <ProjectReference Include="..\Kryolite.EventBus\Kryolite.EventBus.csproj" />
    <ProjectReference Include="..\Kryolite.Model\Kryolite.Model.csproj" />
  </ItemGroup>
</Project>
